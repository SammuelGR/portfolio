{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "npm run i18n:types && tsc -b && vite build",
    "check": "npm run i18n:types && npm run format:check && npm run lint && npm run typecheck",
    "i18n:types": "node scripts/generate-i18n-types.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run i18n:types && tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "i18next": "^26.3.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "prettier": "3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.1"
  }
}
